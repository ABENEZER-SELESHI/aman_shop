NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://aman:aman_secret@localhost:5432/aman_shop?schema=public

# JWT (seller studio only — no customer accounts)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Resend email
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=seller@example.com
EMAIL_FROM=Aman Shop <orders@example.com>

# Optional: seed seller for /studio API
SELLER_EMAIL=amanuel@amanshop.local
SELLER_PASSWORD=ChangeMeSeller123!
SELLER_NAME=Amanuel

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
ORDER_RATE_LIMIT_MAX=10
