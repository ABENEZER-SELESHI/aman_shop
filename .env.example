NODE_ENV=development
PORT=4000

# Neon (recommended) or local Postgres
# Pooled URL for the running app — include pgbouncer=true when using Neon pooler
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true

# Direct (non-pooler) URL for Prisma migrate / introspect — required when using Neon
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# JWT (seller studio only — no customer accounts). Must be unique, min 32 chars each.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated allowed frontend origins (Next may use 3000 or 3001)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Resend email (required when NODE_ENV=production)
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=amanuelseleshi26@gmail.com
EMAIL_FROM=Aman Shop <orders@example.com>

# Studio login only (not shown publicly on the storefront)
SELLER_EMAIL=amanuel@amanshop.local
SELLER_PASSWORD=ChangeMeSeller123!
SELLER_NAME=Amanuel

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
ORDER_RATE_LIMIT_MAX=10
